---
// KeyBrothers Tech logosu: isaret asil logo dosyasindan alinmistir (yeniden cizilmez),
// ad logodaki yazi tipiyle (Poppins) yazilir.
import ThemeImage from './ThemeImage.astro';
import markBlack from '../assets/logolar/kb-isaret-siyah.png';
import markWhite from '../assets/logolar/kb-isaret-beyaz.png';
import { site } from '../data/site';

interface Props {
  label: string;
}

const { label } = Astro.props;
---
<a class="brand" href="/" aria-label={label}>
  <ThemeImage light={markBlack} dark={markWhite} alt="" width={38} loading="eager" class="brand__mark" />
  <span class="brand__name">{site.brand}</span>
</a>
