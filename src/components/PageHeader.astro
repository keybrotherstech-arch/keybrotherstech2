---
// Ic sayfalarin ust basligi.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---
<header class="page-header">
  <div class="wrap" data-reveal-group="90">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 data-reveal>{title}</h1>
    {lead && <p class="page-header__lead" data-reveal>{lead}</p>}
    <slot />
  </div>
</header>
