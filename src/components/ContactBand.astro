---
// Sayfa sonlarindaki iletisim bandi.
import { site } from '../data/site';
---
<section class="section">
  <div class="wrap">
    <div class="contact" data-reveal>
      <div>
        <h2>Projenizi konuşalım.</h2>
        <p>İlk görüşmede ihtiyacı dinler, uygun yolu birlikte belirleriz.</p>
        <p class="contact__details">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.phone.href}>{site.phone.display}</a>
        </p>
      </div>
      <a class="button contact__button" href="/iletisim">İletişime geçin</a>
    </div>
  </div>
</section>
