---
// Temaya gore degisen gorsel: acik ve koyu surum birlikte yazilir, gorunmeyeni CSS gizler.
// Buyuk gorsellerde gizli olan "lazy" oldugu icin indirilmez; kucuk logolar "eager" verilir ki
// tema degisince bekleme olmasin.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { light, dark, alt, widths, sizes, width, loading = 'lazy', class: className } = Astro.props;
const responsive = widths && sizes ? { widths, sizes } : {};
const fixed = width ? { width, densities: [1, 2, 3] as const } : {};
---
<Image src={light} alt={alt} {...responsive} {...fixed} loading={loading} decoding="async" class:list={['t-light', className]} />
<Image src={dark} alt={alt} {...responsive} {...fixed} loading={loading} decoding="async" class:list={['t-dark', className]} />
