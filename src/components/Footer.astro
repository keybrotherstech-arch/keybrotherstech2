---
// Alt bilgi ve kunye. Butun sayfalarda ayni dosya kullanilir.
import Brand from './Brand.astro';
import { site, products } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap">
    <h2 class="visually-hidden">Şirket bilgileri</h2>
    <div class="site-footer__grid">
      <div class="site-footer__company">
        <Brand label="KeyBrothers Tech, sayfa başı" />
        <p class="site-footer__legal-name">{site.legalName}</p>
        <address>
          {site.address.oneLine}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.phone.href}>{site.phone.display}</a>
        </address>
        <dl class="registry">
          <div><dt>MERSİS</dt><dd>{site.registry.mersis}</dd></div>
          <div><dt>Ticaret sicil</dt><dd>{site.registry.tradeRegistry}</dd></div>
          <div><dt>KEP</dt><dd>{site.registry.kep}</dd></div>
        </dl>
      </div>

      <nav class="site-footer__links" aria-label="Alt bilgi bağlantıları">
        <div>
          <p class="site-footer__heading">Ürünler</p>
          <ul>
            {products.map((p) => <li><a href={p.url}>{p.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="site-footer__heading">Şirket</p>
          <ul>
            <li><a href="/#hizmetler">Hizmetler</a></li>
            <li><a href="/#hakkimizda">Hakkımızda</a></li>
            <li><a href="/#iletisim">İletişim</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <p class="site-footer__bottom">© 2026 {site.name}</p>
  </div>
</footer>
