---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBand from '../components/ContactBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services, process } from '../data/site';
---
<BaseLayout
  title="Hizmetler | KeyBrothers Teknoloji"
  description="Kamu kurumları ve şirketler için SaaS ürün geliştirme, yapay zeka ve otomasyon, pazarlama teknolojileri, dijital medya ve oyun hizmetleri."
  path="/hizmetler"
>
  <main id="icerik">
    <PageHeader
      eyebrow="Hizmetler"
      title="Kurumların ihtiyacına göre yazılım ve yapay zeka."
      lead="Kamu kurumları ve şirketler için ihtiyacı birlikte netleştirir, çözümü tasarlar, geliştirir ve yayından sonra bakım ve destekle sürdürürüz. Her projede aynı kalite, güvenlik ve süreklilik ölçütlerini uygularız."
    />

    <section class="section section--after-header">
      <div class="wrap">
        <div class="svc-list">
          {services.map((s, i) => (
            <article class="svc-row" id={s.slug} data-reveal>
              <span class="svc-row__no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <ServiceIcon slug={s.slug} />
                <h2>{s.title}</h2>
                <p>{s.summary}</p>
              </div>
              <ul aria-label={`${s.title} kapsamı`}>
                {s.details.map((d) => <li>{d}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--subtle">
      <div class="wrap">
        <div class="section__heading section__heading--lead" data-reveal>
          <div>
            <p class="eyebrow">Nasıl çalışıyoruz</p>
            <h2>Her adımı görünür, uçtan uca bir süreç.</h2>
          </div>
        </div>
        <ol class="steps" data-reveal-group="160">
          {process.map((step, i) => (
            <li class="step" data-reveal>
              <span class="step__no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ContactBand />
  </main>
</BaseLayout>
