---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactBand from '../components/ContactBand.astro';
import Sectors from '../components/Sectors.astro';
import { site, products, services } from '../data/site';

const arrow = '<path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
---
<BaseLayout
  title="KeyBrothers Teknoloji | Kurumsal Yazılım ve Yapay Zeka"
  description={site.description}
  path="/"
>
  <main id="icerik">
    <section class="home-hero">
      <canvas class="home-hero__net" aria-hidden="true"></canvas>
      <div class="wrap home-hero__grid">
        <div class="home-hero__copy" data-reveal-group="90">
          <p class="eyebrow" data-reveal>KeyBrothers Teknoloji · Ankara</p>
          <h1 data-reveal>Kamu ve özel sektör için yazılım ve yapay zeka.</h1>
          <p class="home-hero__lead" data-reveal>
            KeyBrothers Teknoloji, kamu kurumları ve şirketler için ihtiyaca özel yazılım, yapay zeka ve
            otomasyon çözümleri geliştirir; teslim ettiği sistemlerin yayından sonra da bakımını ve
            desteğini üstlenir.
          </p>
          <div class="actions" data-reveal>
            <a class="button button--light" href="/hizmetler">Hizmetlerimiz</a>
            <a class="button button--ghost" href="/iletisim">Bize ulaşın</a>
          </div>
        </div>

        <nav class="hindex" aria-label="Hizmetler dizini" data-reveal-group="90">
          <p class="hindex__label" data-reveal>Ne yapıyoruz</p>
          <ol>
            {services.map((s, i) => (
              <li data-reveal>
                <a href={`/hizmetler#${s.slug}`}>
                  <span class="hindex__no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="hindex__text">
                    <strong>{s.title}</strong>
                    <span>{s.summary}</span>
                  </span>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={arrow} />
                </a>
              </li>
            ))}
          </ol>
          <a class="hindex__all" href="/hizmetler" data-reveal>
            Hizmetlerin kapsamı
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={arrow} />
          </a>
        </nav>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section__heading section__heading--lead" data-reveal>
          <div>
            <p class="eyebrow">Çalıştığımız alanlar</p>
            <h2>Kamudan özel sektöre, aynı özen.</h2>
          </div>
          <a class="text-link" href="/hakkimizda">
            Hakkımızda
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={arrow} />
          </a>
        </div>
        <Sectors />
      </div>
    </section>

    <section class="section section--subtle">
      <div class="wrap">
        <div class="section__heading section__heading--lead" data-reveal>
          <div>
            <p class="eyebrow">Kendi ürünlerimiz</p>
            <h2>Kendi geliştirip yayında tuttuğumuz platformlar.</h2>
          </div>
          <a class="text-link" href="/urunler">
            Tüm ürünler
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={arrow} />
          </a>
        </div>
        <div class="pcards" data-reveal-group="110">
          {products.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>

    <ContactBand />
  </main>
  <!-- Ust bolumdeki veri agi arka plani (yalniz ana sayfada). -->
  <script is:inline src="/ag.js" defer></script>
</BaseLayout>
