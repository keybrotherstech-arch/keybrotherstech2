---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import ThemeImage from '../components/ThemeImage.astro';
import { site, products, services, process, reasons } from '../data/site';

// Urun ekranlari: her urunun kendi sitesinden alinmis gercek ekran goruntuleri (iki tema).
import aylexLight from '../assets/urunler/aylex-light.png';
import aylexDark from '../assets/urunler/aylex-dark.png';
import vekilinLight from '../assets/urunler/vekilin-light.png';
import vekilinDark from '../assets/urunler/vekilin-dark.png';
import promptturkLight from '../assets/urunler/promptturk-light.png';
import promptturkDark from '../assets/urunler/promptturk-dark.png';

// Urun logolari: kendi dosyalari, yeniden cizilmez.
import aylexLogoDark from '../assets/logolar/aylex-logo-dark.png';
import aylexLogoWhite from '../assets/logolar/aylex-logo-white.png';
import vekilinIcon from '../assets/logolar/vekilin-ikon.svg';
import promptturkIcon from '../assets/logolar/promptturk-ikon.png';

const shots = {
  aylex: { light: aylexLight, dark: aylexDark },
  vekilin: { light: vekilinLight, dark: vekilinDark },
  promptturk: { light: promptturkLight, dark: promptturkDark },
} as const;

// Ust bolumdeki pencere dizisi: arkadan one.
const heroOrder = ['aylex', 'promptturk', 'vekilin'] as const;
const heroWindows = heroOrder.map((key) => products.find((p) => p.key === key)!);

const serviceIcons: Record<string, string> = {
  saas: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h8"/>',
  'yapay-zeka': '<path d="M12 3v18M3 12h18M6 6l12 12M18 6 6 18"/>',
  pazarlama: '<path d="M4 19V9m8 10V5m8 14v-7M2 19h20"/>',
  'medya-oyun': '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 12h5m-2.5-2.5v5M16 11h.01M18 13h.01"/>',
};
---
<BaseLayout
  title="KeyBrothers Teknoloji | Yazılım ve yapay zeka"
  description={site.description}
  path="/"
>
  <main id="icerik">
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">Ankara · Yazılım ve yapay zeka</p>
          <h1>Kendi ürününü geliştiren yazılım şirketi.</h1>
          <p class="hero__lead">
            KeyBrothers Teknoloji; hukuk platformu AyLex’i, Meclis takip platformu Vekilin’i ve tepki
            simülasyonu PromptTurk’ü geliştiriyor. Aynı ürün disipliniyle kamu ve özel sektör
            kurumlarına yazılım ve yapay zeka çözümleri üretiyoruz.
          </p>
          <div class="actions">
            <a class="button button--primary" href="#urunler">Ürünlerimizi inceleyin</a>
            <a class="button button--secondary" href="#iletisim">Bize ulaşın</a>
          </div>
        </div>

        <div class="hero__visual" aria-hidden="true">
          <div class="cascade">
            {heroWindows.map((p) => (
              <div class="cascade__window">
                <BrowserFrame
                  address={p.domain}
                  light={shots[p.key].light}
                  dark={shots[p.key].dark}
                  alt=""
                  sizes="(max-width: 900px) 78vw, 480px"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="urunler">
      <div class="wrap">
        <div class="section__heading">
          <h2>Ürünlerimiz</h2>
        </div>

        <div class="product-list">
          {products.map((p) => (
            <article class="product" data-product={p.key}>
              <div class="product__copy">
                <div class="product__brand">
                  {p.key === 'aylex' && (
                    <ThemeImage light={aylexLogoDark} dark={aylexLogoWhite} alt="AyLex" width={84} loading="eager" class="product__logo" />
                  )}
                  {p.key === 'vekilin' && (
                    <>
                      <Image src={vekilinIcon} alt="" width={36} height={36} class="product__icon" />
                      <span class="product__wordmark product__wordmark--vekilin">Vekilin<span>.</span></span>
                    </>
                  )}
                  {p.key === 'promptturk' && (
                    <>
                      <Image src={promptturkIcon} alt="" width={36} densities={[1, 2, 3]} class="product__icon" />
                      <span class="product__wordmark">PromptTurk</span>
                    </>
                  )}
                </div>
                <p class="product__category">{p.category}</p>
                <h3>{p.title}</h3>
                <p class="product__summary">{p.summary}</p>
                <ul class="product__features">
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
                <a class="product__link" href={p.url}>
                  {p.linkLabel}
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
              <div class="product__visual">
                <BrowserFrame
                  address={p.domain}
                  light={shots[p.key].light}
                  dark={shots[p.key].dark}
                  alt={p.shotAlt}
                  sizes="(max-width: 900px) 90vw, 640px"
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--subtle" id="hizmetler">
      <div class="wrap">
        <div class="section__heading">
          <h2>Hizmetler</h2>
        </div>
        <div class="cards">
          {services.map((s) => (
            <article class="card">
              <div class="card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[s.slug]} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section__heading">
          <h2>Nasıl çalışıyoruz</h2>
        </div>
        <ol class="steps">
          {process.map((step, i) => (
            <li class="step">
              <span class="step__no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--subtle" id="hakkimizda">
      <div class="wrap why">
        <h2>Neden biz</h2>
        <div class="reasons">
          {reasons.map((r) => (
            <article class="reason">
              <h3>{r.title}</h3>
              <p>{r.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="iletisim">
      <div class="wrap">
        <div class="contact">
          <div>
            <h2>Projenizi konuşalım.</h2>
            <p>İlk görüşmede ihtiyacı dinler, uygun yolu birlikte belirleriz.</p>
            <p class="contact__details">
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <a href={site.phone.href}>{site.phone.display}</a>
            </p>
          </div>
          <a class="button contact__button" href={`mailto:${site.email}`}>E-posta gönderin</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
