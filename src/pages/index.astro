---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { site, products } from '../data/site';
import { shot } from '../data/media';

// Ust bolumdeki pencere dizisi: arkadan one.
const heroOrder = ['aylex', 'promptturk', 'vekilin'] as const;
const heroWindows = heroOrder.map((key) => products.find((p) => p.key === key)!);
---
<BaseLayout
  title="KeyBrothers Teknoloji | Yazılım ve yapay zeka"
  description={site.description}
  path="/"
>
  <main id="icerik">
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">Ankara · Yazılım ve yapay zeka</p>
          <h1>Kendi ürününü geliştiren yazılım şirketi.</h1>
          <p class="hero__lead">
            KeyBrothers Teknoloji; hukuk platformu AyLex’i, Meclis takip platformu Vekilin’i ve tepki
            simülasyonu PromptTurk’ü geliştiriyor. Aynı ürün disipliniyle kamu ve özel sektör
            kurumlarına yazılım ve yapay zeka çözümleri üretiyoruz.
          </p>
          <div class="actions">
            <a class="button button--primary" href="/urunler">Ürünlerimizi inceleyin</a>
            <a class="button button--secondary" href="/iletisim">Bize ulaşın</a>
          </div>
        </div>

        <div class="hero__visual" aria-hidden="true">
          <div class="cascade">
            {heroWindows.map((p) => {
              const image = shot(p.key);
              return (
                <div class="cascade__window">
                  <BrowserFrame address={p.domain} light={image.light} dark={image.dark} alt="" sizes="(max-width: 1000px) 78vw, 480px" />
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="wrap">
        <div class="section__heading">
          <h2>Ürünlerimiz</h2>
          <a class="text-link" href="/urunler">
            Tüm ürünler
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="pcards">
          {products.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>

    <ContactBand />
  </main>
</BaseLayout>
